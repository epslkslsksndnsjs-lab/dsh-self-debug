#!/usr/bin/env bash
# Fake `uv` stub for offline dsh-self-debug tests. Mimics `uv run <tool>`
# failure output so diagnosis classifications can be exercised without a real
# Python toolchain (issue #6 fixture strategy: PATH injection, not real tools).
case "$2" in
  pytest)
    cat <<'PYEOF'
============================= test session starts ==============================
platform linux -- Python 3.12.0, pytest-8.3.2, pluggy-1.5.0
collected 1 item

test_sample.py F                                                         [100%]

=================================== FAILURES ===================================
_________________________________ test_answer __________________________________

    def test_answer():
>       assert 2 + 2 == 5
E       assert 4 == 5

test_sample.py:2: AssertionError
=========================== short test summary info ============================
FAILED test_sample.py::test_answer - assert 4 == 5
========================= 1 failed, 0 passed in 0.01s =========================
PYEOF
    exit 1
    ;;
  ruff)
    echo "All checks passed!"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
