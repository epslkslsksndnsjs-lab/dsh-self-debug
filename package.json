{
  "name": "dsh-self-debug",
  "version": "0.1.0",
  "description": "In-task self-check tool plugin for DeepSeek Harness: detect project type, run the matching verification pipeline, and return a deterministic pure-text report.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "dsh/index.ts",
  "files": [
    "cordis.patch.yml",
    "dsh",
    "src"
  ],
  "exports": {
    ".": "./dsh/index.ts",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:dsh": "tsc -p dsh/tsconfig.json",
    "admit": "node --experimental-strip-types scripts/admit.ts",
    "benchmark": "node --experimental-strip-types benchmark/run.ts",
    "bench:aggregate": "node --experimental-strip-types benchmark/aggregate.ts --dir .bench/records"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  }
}
